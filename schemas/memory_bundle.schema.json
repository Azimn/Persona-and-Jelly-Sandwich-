{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_bundle.schema.json",
  "title": "Portable Memory Bundle",
  "type": "object",
  "required": ["schema_version", "subject_id", "memories"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "summary", "meaning", "provenance"],
        "properties": {
          "id": {"type": "string"},
          "tier": {"enum": ["working", "episodic", "relationship", "semantic", "narrative", "foundational"]},
          "summary": {"type": "string"},
          "meaning": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "emotional_charge": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_record_ids": {"type": "array", "items": {"type": "string"}},
          "contradicts": {"type": "array", "items": {"type": "string"}},
          "supersedes": {"type": "array", "items": {"type": "string"}},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "protected": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "optional_indexes": {
      "type": "object",
      "description": "Rebuildable acceleration data; never identity authority."
    }
  },
  "additionalProperties": false
}
